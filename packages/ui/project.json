{
  "name": "crossword_solver.ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/ui/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "pnpm dev --host 127.0.0.1",
        "cwd": "packages/ui"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/ui/dist"],
      "options": {
        "command": "pnpm build",
        "cwd": "packages/ui"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm lint",
        "cwd": "packages/ui"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/ui/coverage"],
      "options": {
        "command": "pnpm test",
        "cwd": "packages/ui"
      }
    }
  }
}