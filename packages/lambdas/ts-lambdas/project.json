{
  "name": "@crossword-solver/ts-lambdas",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/lambdas/ts-lambdas/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "components": [
      {
        "generator": "ts#lambda-function",
        "path": "src/create-attempt/create-attempt.ts",
        "name": "create-attempt"
      },
      {
        "generator": "ts#lambda-function",
        "path": "src/automatic-answers/automatic-answers.ts",
        "name": "automatic-answers"
      }
    ]
  },
  "targets": {
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["default"],
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}/bundle"
      ],
      "options": {
        "command": "rolldown -c rolldown.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "assemble": {
      "dependsOn": ["bundle"]
    },
    "build-create-attempt": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/lambdas/ts-lambdas/create-attempt",
        "main": "packages/lambdas/ts-lambdas/src/create-attempt/create-attempt.ts",
        "tsConfig": "packages/lambdas/ts-lambdas/tsconfig.lib.json",
        "bundle": true,
        "thirdParty": true,
        "format": ["esm"],
        "platform": "node",
        "target": "node22"
      }
    },
    "build-automatic-answers": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/lambdas/ts-lambdas/automatic-answers",
        "main": "packages/lambdas/ts-lambdas/src/automatic-answers/automatic-answers.ts",
        "tsConfig": "packages/lambdas/ts-lambdas/tsconfig.lib.json",
        "bundle": true,
        "thirdParty": true,
        "format": ["esm"],
        "platform": "node",
        "target": "node22"
      }
    }
  }
}
